# Copy to .env and edit. Never commit .env.
APP_ENVIRONMENT=development
APP_MODEL_DIR=artifacts
APP_EXCHANGE_ID=binance
APP_MARKET_TIMEOUT_MS=10000
APP_MARKET_MAX_RETRIES=3
APP_MARKET_CANDLES_LIMIT=500
APP_MAX_STALENESS_CANDLES=3

# JSON list of allowed browser origins (no "*"), e.g. your Vercel URL in production
APP_CORS_ORIGINS=["http://localhost:5173"]

# Local development: a SQLite file (created automatically, relative to backend/).
# PostgreSQL. Required when APP_ENVIRONMENT=production. Leave empty to run without history.
# Example: postgresql://user:password@localhost:5432/crypto_predictions
APP_DATABASE_URL=sqlite:///data/history.db
APP_DB_CONNECT_TIMEOUT_S=5
APP_DB_STATEMENT_TIMEOUT_MS=5000
APP_DB_POOL_SIZE=5

# Tried in order when the main exchange fails. The models were trained on Binance data.
APP_FALLBACK_EXCHANGE_IDS=[]
# Shared cache and rate limits. Needed when running more than one worker or instance.
APP_REDIS_URL=
# Requests per minute per client (0 = off)
APP_RATE_LIMIT_GENERAL=120
APP_RATE_LIMIT_PREDICT=10
APP_RATE_LIMIT_SCAN=6
# Only set this to a header your proxy always overwrites (e.g. CF-Connecting-IP behind Cloudflare)
APP_CLIENT_IP_HEADER=
# Keep the market scan warm in the background
APP_BACKGROUND_JOBS=false
# Delete forecasts older than this many days (0 = keep all)
APP_HISTORY_RETENTION_DAYS=0
# Set a token to switch on GET /metrics; set a DSN to switch on Sentry
APP_METRICS_TOKEN=
APP_SENTRY_DSN=
# Save a forecast for these coins all day (needs APP_BACKGROUND_JOBS=true), e.g. ["BTC/USDT","ETH/USDT"]
APP_AUTO_FORECAST_SYMBOLS=[]
# artifacts/challenger is tested in the background. true = use it for the answers (see its metrics first)
APP_SERVE_CHALLENGER=false
