# Copy to .env and edit. Never commit .env.
APP_ENVIRONMENT=development
APP_MODEL_DIR=artifacts
APP_EXCHANGE_ID=binance
APP_MARKET_TIMEOUT_MS=10000
APP_MARKET_MAX_RETRIES=3
APP_MARKET_CANDLES_LIMIT=500
APP_MAX_STALENESS_CANDLES=3

# JSON list of allowed browser origins (no "*"), e.g. your Vercel URL in production
APP_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL. Required when APP_ENVIRONMENT=production. Leave empty to run without history.
# Example: postgresql://user:password@localhost:5432/crypto_predictions
APP_DATABASE_URL=
APP_DB_CONNECT_TIMEOUT_S=5
APP_DB_STATEMENT_TIMEOUT_MS=5000
APP_DB_POOL_SIZE=5
